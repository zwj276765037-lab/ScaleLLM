set root [file normalize [file join [file dirname [info script]] ../..]];set out [file normalize $::env(HAP_REPORT_DIR)];file mkdir $out;set part xcvu9p-flga2104-2L-e
create_project -in_memory -part $part;read_verilog -sv [file join $root rtl attention hap_axi256_dma.sv];read_verilog -sv [file join $root rtl integration hap_mlp_meta_dma_loader.sv];read_xdc [file join $root vivado constraints mlp_meta_dma_loader_ooc_150mhz.xdc]
synth_design -top hap_mlp_meta_dma_loader -part $part -mode out_of_context;opt_design;place_design;phys_opt_design -directive AggressiveExplore;route_design -directive AggressiveExplore
report_timing_summary -delay_type min_max -max_paths 100 -file [file join $out timing_summary.rpt];report_utilization -file [file join $out utilization.rpt];report_route_status -file [file join $out route_status.rpt];report_drc -file [file join $out drc.rpt];write_checkpoint -force [file join $out post_route.dcp]
set wns [get_property SLACK [lindex [get_timing_paths -delay_type max -max_paths 1] 0]];set whs [get_property SLACK [lindex [get_timing_paths -delay_type min -max_paths 1] 0]];set unr [llength [get_nets -quiet -hierarchical -filter {ROUTE_STATUS == UNROUTED || ROUTE_STATUS == PARTIALLY_ROUTED}]];set drc [llength [get_drc_violations -quiet -filter {SEVERITY == Error}]];set dsp [llength [get_cells -quiet -hierarchical -filter {REF_NAME == DSP48E2}]];set lut [llength [get_cells -quiet -hierarchical -filter {REF_NAME =~ LUT*}]];set ff [llength [get_cells -quiet -hierarchical -filter {REF_NAME =~ FD*}]];set status [expr {$wns>=0&&$whs>=0&&$unr==0&&$drc==0&&$dsp==0?"PASS":"FAIL"}];set f [open [file join $out summary.txt] w];foreach {k v} [list tool [version -short] part $part top hap_mlp_meta_dma_loader wns_ns $wns whs_ns $whs lut_primitives $lut ff_primitives $ff dsp48e2 $dsp unrouted_nets $unr drc_errors $drc status $status] {puts $f "$k=$v"};close $f;if {$status ne "PASS"} {error "MLP meta DMA loader OOC failed"}
