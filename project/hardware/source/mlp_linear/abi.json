    "rejection_has_completion": false,
    "checks_before_any_dma": true,
    "axi_b_response_after_validation": true,
    "host_sequence": [
      "hold exclusive MLP control lock",
      "read versions and clear/check prior ADMISSION_ERROR==0",
      "write all descriptor fields",
      "write START",
      "ordered read ADMISSION_ERROR; nonzero => rejected, never wait for completion",
      "if zero, wait on JOB_STATUS; inspect matching DONE when completion_valid; reset_required => fail immediately",
      "release control lock after submission confirmation"
    ],
    "simultaneous_error_priority": [
      "hard_reset",
      "fatal_AXI_or_reader",
      "internal_protocol_or_numeric",
      "input_record_error",
      "watchdog",
      "explicit_abort",
      "success"
