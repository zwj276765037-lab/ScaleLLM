  "completion": {
    "success_requires_all_paths_drained": true,
    "stable_until_id_ack": true,
    "ack_requires": [
      "full strobe",
      "completion valid",
      "matching command_id",
      "busy==0",
      "quiescent==1",
      "reset_required==0",
      "not maintenance"
    ],
    "input_bytes": "576 * full legal records committed to cache",
    "output_bytes": "sum bytes in OKAY B-confirmed bursts; not proof of valid partial tensor",
    "record_count": "complete GU/DOWN records accepted by output writer before terminal snapshot",
    "fatal_snapshot": "latch first error, identity and counters once when entering FAULT; completion_valid may be 1 while busy/quiescent reflect outstanding hardware; ACK prohibited by reset_required",
    "recoverable_input_error": "drain/discard entire accepted input DMA, no compute/output start, then failure completion; ACK followed by job_clear",
    "abort": "finish the already accepted healthy job, discard success interpretation, use existing controlled maintenance barrier, invalidate epoch/resident metadata, publish ABORTED completion after quiescence; errors dominate",
    "hard_clear": {
      "precondition": "trusted existing maintenance barrier has established safe reset boundary; never clear accepted external AXI transactions unsafely",
      "preserve": [
        "unacked completion_valid",
        "DONE identity",
        "DONE first error",
        "DONE frozen counters",
        "ADMISSION_ERROR"
      ],
      "clear": [
        "active job local protocol after safe boundary",
        "live fault",
        "live reset_required",
        "epoch binding"
      ],
      "active_without_done": "snapshot active identity/counters as MAINTENANCE_ABORTED before clearing live state",
      "postcondition": "if DONE valid then COMPLETE with busy=0 and quiescent=1; job_error remains true for nonzero DONE_ERROR; matching ID ACK is permitted after live recovery",
      "core_reset": "clears DONE, admission and epoch; Host must retain diagnostics before reset"
    }
  },
  "counters": {
    "width": 32,
    "overflow": "saturate at 0xffffffff; never wrap",
    "snapshot": "first terminal success/recoverable failure/fatal entry",
    "load_cycles": "cycles in LOAD excluding validation",
    "compute_cycles": "compute command fire through compute_done inclusive; includes output-backpressure",
    "store_drain_cycles": "writer arm acceptance through final store_done/all-path drain inclusive; overlaps compute",
    "stall_cycles": "one per core cycle with any active valid&&!ready on load/cache/compute/metadata/output endpoints; count union, no additive interpretation",
    "default_command_timeout_cycles": 10000000,
    "timeout_scope": "START acceptance until terminal; param 0 allowed for bounded testbench only"
  },
