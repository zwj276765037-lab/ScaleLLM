      "matches_inherited_physopt_constraint_sha": true,
      "text": "# M002 constraint policy, reviewed 2026-10-15.\n# Actual board clocks are generated by the board/IP design:\n#   core_clk = 100 MHz (10 ns); DDR0/DDR1 UI = 200 MHz (5 ns).\n# board_clock_domains.xdc and build_vcu118_board.tcl audit those clocks.\n# This file adds no timing exceptions, derates, LOCs or Pblocks.\n# The previous reset-name multicycles and guessed placement had no protocol or\n# current-device evidence. A future physical change requires fresh path evidence\n# and a separately reviewed constraint; loading this file proves no timing gain.\nputs {INFO: [M002] Clock contract: core100 / DDR UI200; no added timing exceptions or placement.}\n"
    },
    {
      "path": "project/hardware/vivado/project/m002_E005_R002_AT006_fresh/scalellm_vcu118_f05.gen/sources_1/bd/scalellm_vcu118_f05_bd/ip/scalellm_vcu118_f05_bd_d0_mig_slice_0/scalellm_vcu118_f05_bd_d0_mig_slice_0_clocks.xdc",
      "sha256": "2aaba35a2e49e7572ea5cfbba29d4f9c6260d3a523271f1e70aad171a64016d5",
      "matches_inherited_physopt_constraint_sha": true,
      "text": "###############################################################################################################\n# Core-Level Timing Constraints for axi_register_slice Component \"scalellm_vcu118_f05_bd_d0_mig_slice_0\"\n###############################################################################################################\n#\n# This component is configured in a multi-SLR crossing mode.\n# Some storage elements enter reset asynchronously to withstand long inter-SLR delays.\n# The async clear (CLR) inputs of these flops are excluded from timing analysis by the following constraint:\nset_false_path -through [get_pins -filter {REF_PIN_NAME=~CLR} -of_objects  [get_cells -hierarchical *asyncclear*]]\n#\n#\n\n\n\n"
    },
    {
      "path": "project/hardware/vivado/project/m002_E005_R002_AT006_fresh/scalellm_vcu118_f05.gen/sources_1/bd/scalellm_vcu118_f05_bd/ip/scalellm_vcu118_f05_bd_d1_mig_slice_0/scalellm_vcu118_f05_bd_d1_mig_slice_0_clocks.xdc",
      "sha256": "8c969450f4c4d83c620907ddb943b3f59e15ab59c6cbc8642d0456007b4d9e2a",
      "matches_inherited_physopt_constraint_sha": true,
      "text": "###############################################################################################################\n# Core-Level Timing Constraints for axi_register_slice Component \"scalellm_vcu118_f05_bd_d1_mig_slice_0\"\n###############################################################################################################\n#\n# This component is configured in a multi-SLR crossing mode.\n# Some storage elements enter reset asynchronously to withstand long inter-SLR delays.\n# The async clear (CLR) inputs of these flops are excluded from timing analysis by the following constraint:\nset_false_path -through [get_pins -filter {REF_PIN_NAME=~CLR} -of_objects  [get_cells -hierarchical *asyncclear*]]\n#\n#\n\n\n\n"
