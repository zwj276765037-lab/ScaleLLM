+# Preserve the native Tcl stack before returning the original error unchanged.
+proc m003::snapshot {phase out} {
+    set code [catch {snapshot_body $phase $out} message options]
+    if {$code == 1} {
+        set trace [file join $out m003_snapshot_${phase}_[pid]_error_info.txt]
+        if {[catch {
+            set handle [open $trace {WRONLY CREAT EXCL}]
+            puts $handle "errorcode=[dict get $options -errorcode]"
+            puts $handle [dict get $options -errorinfo]
+            close $handle
+        } trace_error]} {puts stderr "M003 snapshot trace preservation failed: $trace_error"}
+    }
+    return -options $options $message
+}
