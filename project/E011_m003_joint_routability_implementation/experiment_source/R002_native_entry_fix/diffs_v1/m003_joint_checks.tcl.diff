+proc m003::payload_members {} {
+    variable parent_scope
+    set family_bits [dict create]
+    # Select only the two payload families. Count/state registers are distinct
+    # roles; replicas and malformed members of either family still fail below.
+    set selected [get_cells -quiet -hier -filter [format {IS_PRIMITIVE == 1 && (NAME =~ "%s/parent_head_r_reg*" || NAME =~ "%s/parent_tail_r_reg*")} $parent_scope $parent_scope]]
+    foreach cell $selected {
+        set name [get_property NAME $cell]
+        if {![regexp {parent_(head|tail)_r_reg\[([0-9]+)\]$} $name -> family bit]} {error "M003 unresolved/replicated payload origin: $name"}
+        if {[get_property REF_NAME $cell] ni {FDRE FDCE FDSE FDPE} || $bit>=6560 || [dict exists $family_bits $family $bit]} {error "M003 invalid payload member: $name"}
+        dict set family_bits $family $bit $cell
+    }
+    foreach family {head tail} {
