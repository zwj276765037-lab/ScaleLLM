+    expected = dict(part=['xcvu9p-flga2104-2L-e'], board_part=['xilinx.com:vcu118:part0:2.0'],
+        ip_vlnv=['xilinx.com:ip:ddr4_phy:2.2']*2, ip_module_name=modules,
