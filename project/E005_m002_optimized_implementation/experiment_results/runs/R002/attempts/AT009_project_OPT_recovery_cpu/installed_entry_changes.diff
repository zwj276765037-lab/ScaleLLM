+    script_record = records[original/'get_cs_ip.tcl']
+    script = Path(script_record['path']).read_text()
+    log_record = records[original/'vivado.log']
+    log = Path(log_record['path']).read_text()
+    repo = project/'scalellm_vcu118_f05.cache/ip'
