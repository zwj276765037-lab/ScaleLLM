set_property src_info {type:SCOPED_XDC file:441 line:59 export:INPUT save:NONE read:READ} [current_design]
set_max_delay -datapath_only -from $_xlnx_shared_i35 -to [get_cells -hierarchical -filter {NAME =~ *doutb*reg*}] 4.000

# Vivado Generated miscellaneous constraints 

#revert back to original instance
current_instance -quiet
