 // ====================== static functions ========================================================
 
+// Freeze the per-device policy before any WDF interrupt can be enabled.
+static NTSTATUS InitializeUserIrqPolicy(IN PXDMA_DEVICE xdma) {
+    xdma->userIrqAllowedMask = 0xFFFFFFFFUL;
+#if XDMA_GU_POLLING_9018
+    BUS_INTERFACE_STANDARD pciBus;
+    PCI_COMMON_HEADER pciHeader;
+    NTSTATUS status = WdfFdoQueryForInterface(xdma->wdfDevice,
+        &GUID_BUS_INTERFACE_STANDARD, (PINTERFACE)&pciBus,
+        sizeof(BUS_INTERFACE_STANDARD), 1, NULL);
+    if (!NT_SUCCESS(status)) {
+        return status;
+    }
+    ULONG bytesRead = pciBus.GetBusData(pciBus.Context, PCI_WHICHSPACE_CONFIG,
+        &pciHeader, 0, PCI_COMMON_HDR_LENGTH);
+    pciBus.InterfaceDereference(pciBus.Context);
+    if (bytesRead != (ULONG)PCI_COMMON_HDR_LENGTH) {
+        return STATUS_INVALID_DEVICE_REQUEST;
+    }
+    if (pciHeader.VendorID == 0x10EE && pciHeader.DeviceID == 0x9018) {
+        xdma->userIrqAllowedMask = XDMA_GU_USER_IRQ_ALLOWED_9018;
+    }
+#endif
+    return STATUS_SUCCESS;
+}
+
