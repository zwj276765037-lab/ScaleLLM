set e [file dirname [file normalize [info script]]];set id $::env(M8_CASE_ID);set n $::env(M8_CASE_NAME);set pd [file join $e artifacts project_$n];file delete -force $pd;create_project m8_$n $pd -part xcvu9p-flga2104-2L-e -force
proc mip {n op p} {create_ip -name floating_point -vendor xilinx.com -library ip -module_name $n;set_property -dict [concat [list CONFIG.Flow_Control NonBlocking CONFIG.Operation_Type $op] $p] [get_ips $n];generate_target all [get_ips $n]}
if {$id==1} {mip m8_f16_sub Add_Subtract [list CONFIG.Add_Sub_Value Subtract CONFIG.A_Precision_Type Half CONFIG.Result_Precision_Type Half];mip m8_f16_exp Exponential [list CONFIG.A_Precision_Type Half CONFIG.Result_Precision_Type Half];mip m8_f16_add Add_Subtract [list CONFIG.Add_Sub_Value Add CONFIG.A_Precision_Type Half CONFIG.Result_Precision_Type Half];mip m8_f16_div Divide [list CONFIG.A_Precision_Type Half CONFIG.Result_Precision_Type Half];mip m8_f16_to_f32 Float_to_float [list CONFIG.A_Precision_Type Half CONFIG.Result_Precision_Type Single CONFIG.C_Result_Exponent_Width 8 CONFIG.C_Result_Fraction_Width 24]}
if {$id==2} {mip m8_f32_sub Add_Subtract [list CONFIG.Add_Sub_Value Subtract CONFIG.A_Precision_Type Single CONFIG.Result_Precision_Type Single];mip m8_f32_exp Exponential [list CONFIG.A_Precision_Type Single CONFIG.Result_Precision_Type Single];mip m8_f32_add Add_Subtract [list CONFIG.Add_Sub_Value Add CONFIG.A_Precision_Type Single CONFIG.Result_Precision_Type Single];mip m8_f32_div Divide [list CONFIG.A_Precision_Type Single CONFIG.Result_Precision_Type Single]}
mip m8_f32_mul Multiply [list CONFIG.A_Precision_Type Single CONFIG.Result_Precision_Type Single];mip m8_f32_to_u17 Float_to_fixed [list CONFIG.A_Precision_Type Single CONFIG.Result_Precision_Type Custom CONFIG.C_Result_Exponent_Width 17 CONFIG.C_Result_Fraction_Width 0 CONFIG.C_Has_UNDERFLOW 0 CONFIG.C_Has_OVERFLOW 0]
foreach s [list [file join $e rtl m8_fp_softmax.sv] [file join $e tb m8_softmax_tb.sv]] {add_files $s;set_property file_type SystemVerilog [get_files $s]};set_property top m8_softmax_tb [get_filesets sim_1];set_property generic "CASE_ID=$id DATA_DIR=[file join $e data]" [get_filesets sim_1];launch_simulation -simset sim_1 -mode behavioral;run all;close_sim;close_project
