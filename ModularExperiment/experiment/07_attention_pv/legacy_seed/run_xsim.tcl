set e [file dirname [file normalize [info script]]];set id $::env(M9_CASE_ID);set n $::env(M9_CASE_NAME);set pd [file join $e artifacts project_$n];file delete -force $pd;create_project m9_$n $pd -part xcvu9p-flga2104-2L-e -force
proc mip {n op p} {create_ip -name floating_point -vendor xilinx.com -library ip -module_name $n;set_property -dict [concat [list CONFIG.Flow_Control NonBlocking CONFIG.Operation_Type $op] $p] [get_ips $n];generate_target all [get_ips $n]}
if {$id==1} {mip m9_f16_mul Multiply [list CONFIG.A_Precision_Type Half CONFIG.Result_Precision_Type Half];mip m9_f16_add Add_Subtract [list CONFIG.Add_Sub_Value Add CONFIG.A_Precision_Type Half CONFIG.Result_Precision_Type Half];mip m9_f16_to_f32 Float_to_float [list CONFIG.A_Precision_Type Half CONFIG.Result_Precision_Type Single CONFIG.C_Result_Exponent_Width 8 CONFIG.C_Result_Fraction_Width 24]}
if {$id==2} {mip m9_f32_mul Multiply [list CONFIG.A_Precision_Type Single CONFIG.Result_Precision_Type Single];mip m9_f32_add Add_Subtract [list CONFIG.Add_Sub_Value Add CONFIG.A_Precision_Type Single CONFIG.Result_Precision_Type Single]}
mip m9_f32_to_s24 Float_to_fixed [list CONFIG.A_Precision_Type Single CONFIG.Result_Precision_Type Custom CONFIG.C_Result_Exponent_Width 8 CONFIG.C_Result_Fraction_Width 16 CONFIG.C_Has_UNDERFLOW 0 CONFIG.C_Has_OVERFLOW 0]
foreach s [list [file join $e rtl m9_fp_pv.sv] [file join $e tb m9_pv_tb.sv]] {add_files $s;set_property file_type SystemVerilog [get_files $s]};set_property top m9_pv_tb [get_filesets sim_1];set_property generic "CASE_ID=$id DATA_DIR=[file join $e data]" [get_filesets sim_1];launch_simulation -simset sim_1 -mode behavioral;run all;close_sim;close_project
