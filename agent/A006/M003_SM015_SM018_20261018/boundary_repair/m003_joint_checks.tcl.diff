+# Independent upstream aliases retained in this synthesis, selected as actual
+# native nets. Do not infer S/L/R truth from the protected sinks being checked.
+proc m003::boundary_net {name} {
+    # Positional get_nets is a pattern API; these upstream scalar names must be
+    # literal. Do not silently turn generated bus brackets into wildcard input.
+    if {[regexp {[*?\[\]\\]} $name]} {error "M003 boundary anchor is not a literal scalar name: $name"}
+    set net [one get_nets $name]
+    if {[string tolower [get_property CLASS $net]] ne "net"} {error "M003 boundary anchor is not a net: $name"}
+    return $net
+}
+proc m003::boundary_names {tag net} {
+    # -of_objects documents pins/ports/cells/clocks, not net inputs. Expand the
+    # actual exact-name selected net through the documented positional pattern.
+    set nets [m003_conn::bounded_objects [get_nets -quiet -segments $net] boundary_segments]
+    set names [collection_property NAME $nets]
+    if {![llength $nets] || $net ni $nets || [llength $nets]!=[llength [lsort -unique $nets]] || [llength $names]!=[llength [lsort -unique $names]]} {error "M003 invalid actual boundary segment membership: $tag"}
+    foreach object $nets {if {[string tolower [get_property CLASS $object]] ne "net"} {error "M003 boundary segment is not a net: $tag"}}
+    m003_conn::event boundary_source_selected [dict create tag $tag anchor [get_property NAME $net] segment_count [llength $nets]]
+    return $names
+}
