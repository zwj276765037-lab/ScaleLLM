def validate_native_reset(s, originals, helpers, sources, require):
    """Prove actual asynchronous CLR function from bounded same-call provenance.

    Cell IS_CLR_INVERTED may be empty/unset. Preserve that observation; require
    actual CLR pin IS_INVERTED as the polarity evidence, and reject a conflicting
    known cell attribute. Never coerce an empty cell property to zero.
    """
    try:
        def need(ok, message):
            if not ok: raise ValueError(message)
        def boolean(value):
            need(isinstance(value, str) and value.lower() in ('0','1','false','true'), 'invalid or missing native pin/cell inversion boolean')
            return int(value.lower() in ('1','true'))
        def vector(value):
            need(isinstance(value, str), 'native reset NAME vector is not text')
            result=words(value)
            need(bool(result) and len(result)<=131072 and all(result) and len(result)==len(set(result)), 'native reset NAME vector missing/duplicate/empty')
            return result
        records=s.get('reset_provenance')
        need(isinstance(records,list) and records and all(isinstance(r,dict) for r in records), 'native reset provenance missing')
        need(all(r.get('kind') in ('group','root','node','input','endpoint','complete') for r in records), 'unknown reset provenance row')
        roots=[r for r in records if r['kind']=='root'];done=[r for r in records if r['kind']=='complete']
        need(len(roots)==len(done)==1, 'reset root/completion exact coverage missing')
        gs=[r for r in records if r['kind']=='group'];ns=[r for r in records if r['kind']=='node'];ips=[r for r in records if r['kind']=='input'];eps=[r for r in records if r['kind']=='endpoint']
        need(len(eps)==51 and len(ns)<=16 and len(ips)<=64, 'reset endpoint/node/pin bound changed')
        need(all(str(done[0].get(k))==str(v) for k,v in [('endpoints',51),('nodes',len(ns)),('input_pins',len(ips)),('groups',len(gs))]), 'reset completion counts mismatch')
        groups={};aliases=set()
        for g in gs:
            gid=g.get('id');need(isinstance(gid,str) and gid and gid not in groups,'duplicate/invalid reset group')
            nets=vector(g.get('nets'));need(str(g.get('actual_segment_count'))==str(len(nets)),'reset NAME vector/native count mismatch')
            need(not aliases.intersection(nets),'overlapping reset groups');aliases.update(nets)
            need(g.get('direct_net') in nets,'reset actual direct net missing')
            drivers=words(g.get('leaf_drivers',''));ports=words(g.get('primary_ports',''));dirs=words(g.get('source_directions',''))
            need((len(drivers)==1 and not ports and dirs==['OUT']) or (not drivers and len(ports)==1 and dirs==['IN']), 'reset source not exclusive or wrong direction')
            groups[gid]=g
        root=roots[0];rg=root.get('group');need(rg in groups,'reset root group missing')
        need(set(vector(groups[rg]['nets']))==sources.get('reset',set()),'independent reset root does not match selected source')
        anchor=root.get('anchor',root.get('port'));need(anchor in sources.get('reset',set()),'independent reset anchor missing')
        if root.get('direction')=='OUT':
            need(words(groups[rg].get('leaf_drivers',''))==[root.get('actual_source')],'reset root actual source mismatch')
        else:
            need(root.get('direction')=='IN' and words(groups[rg].get('primary_ports',''))==[root.get('port')],'reset root primary input mismatch')
        nodes={};outgroups={}
        for n in ns:
            cell=n.get('cell');gid=n.get('output_group')
            need(isinstance(cell,str) and cell and cell not in nodes and gid in groups and gid not in outgroups and gid!=rg,'duplicate/invalid reset driver node')
            need(n.get('output_pin')==cell+'/O' and n.get('output_direction')=='OUT' and words(groups[gid].get('leaf_drivers',''))==[n['output_pin']] and not words(groups[gid].get('primary_ports','')),'reset driver output/owner/group mismatch')
            nodes[cell]=n;outgroups[gid]=cell
        inputs={}
        for p in ips:
            cell=p.get('cell');pin=p.get('pin');need(cell in nodes and isinstance(pin,str) and re.fullmatch(r'I[0-5]',pin) and p.get('actual_pin')==cell+'/'+pin and p.get('direction')=='IN' and p.get('group') in groups,'reset LUT input identity/direction/group mismatch')
            need((cell,pin) not in inputs,'duplicate reset LUT input');inputs[cell,pin]=p['group']
        cache={rg:(0,1)};visiting=set();used_nodes=set();used_groups={rg}
        def evaluate(gid,depth=0):
            need(depth<=4 and gid not in visiting,'reset graph depth/cycle')
            used_groups.add(gid)
            if gid in cache:return cache[gid]
            need(gid in outgroups,'reset group lacks actual combinational driver')
            visiting.add(gid);cell=outgroups[gid];node=nodes[cell];used_nodes.add(cell);ref=node.get('REF_NAME','')
            if ref in ('GND','VCC'):
                need(not any(c==cell for c,p in inputs),'constant reset driver has unexpected inputs');result=(int(ref=='VCC'),)*2
            else:
                need(bool(re.fullmatch(r'LUT[1-6]',ref)),'unsupported reset combinational primitive')
                width=int(ref[-1]);need({p for c,p in inputs if c==cell}=={'I'+str(i) for i in range(width)},'reset LUT input exact coverage mismatch')
                truth=init(node.get('INIT',''));need(0<=truth<(1<<(1<<width)),'reset LUT INIT out of range')
                values=[evaluate(inputs[cell,'I'+str(i)],depth+1) for i in range(width)]
                result=tuple((truth>>sum(values[i][bit]<<i for i in range(width)))&1 for bit in (0,1))
            visiting.remove(gid);cache[gid]=result;return result
        expected={r['NAME']:('core',-1,int(r['bit']),r) for r in originals}
        expected.update({r['NAME']:('helper',int(r['slice']),int(r['bit']),r) for r in helpers})
        need(len(expected)==51,'reset reference endpoint coverage mismatch');seen=set()
        for ep in eps:
            cell=ep.get('cell');need(cell in expected and cell not in seen,'unknown/duplicate reset endpoint');seen.add(cell)
            family,slice_id,bit,row=expected[cell];gid=ep.get('group')
            need(ep.get('family')==family and str(ep.get('slice'))==str(slice_id) and str(ep.get('bit'))==str(bit) and ep.get('CLR_pin')==cell+'/CLR','reset endpoint family/bit/pin mismatch')
            need(gid in groups and set(vector(groups[gid]['nets']))==set(words(row.get('CLR_nets',''))),'reset endpoint actual CLR group mismatch')
            need(ep.get('REF_NAME')==row.get('REF_NAME')=='FDCE' and init(ep.get('INIT',''))==0,'asynchronous reset primitive/initial state changed')
            need('IS_CLR_INVERTED' in ep and 'pin_IS_INVERTED' in ep,'reset inversion property missing')
            pin_inv=boolean(ep['pin_IS_INVERTED']);cell_raw=ep['IS_CLR_INVERTED']
            need(isinstance(cell_raw,str),'invalid raw cell reset inversion value')
            if cell_raw not in ('','NOT_SUPPORTED'):
                need(boolean(cell_raw)==pin_inv,'known cell and actual CLR pin inversion conflict')
            function=tuple(v^pin_inv for v in evaluate(gid))
            need(function==(1,0),'asynchronous reset function differs from NOT selected core_rst_n')
        need(seen==set(expected) and used_nodes==set(nodes) and used_groups==set(groups),'unused/missing reset provenance evidence')
    except (ValueError,KeyError,TypeError,IndexError) as exc:
        require(False,'native asynchronous reset provenance: '+str(exc))

