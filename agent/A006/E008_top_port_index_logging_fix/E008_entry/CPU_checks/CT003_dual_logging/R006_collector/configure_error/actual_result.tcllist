mode configure_error code 1 result ORIGINAL_CONFIG_FAILURE options {-errorcode CPU_EXPECTED_ALIAS_CONFIG_FAILURE -errorstack {INNER {invokeStk1 fconfigure file3 -buffering full -buffersize 262144 -encoding utf-8 -translation lf} CALL {directed_alias_trace_open test} CALL {slr2::cut test}} -errorinfo {ORIGINAL_CONFIG_FAILURE
    while executing
"fconfigure $aliasTraceChannel -buffering full -buffersize 262144 -encoding utf-8 -translation lf"
    (procedure "directed_alias_trace_open" line 6)
    invoked from within
"directed_alias_trace_open $point"
    (procedure "slr2::cut" line 6)
    invoked from within
"slr2::cut $point"} -errorline 1 -code 1 -level 0} sidecar_channel {}
